# =============================================================================
# Tune Server (Rust) — Environment Configuration
# Copy this file to .env and adjust values for your setup.
# The server loads .env automatically from the working directory.
# On Windows, it also checks %LOCALAPPDATA%\TuneServer\.env and
# the directory containing tune-server.exe.
# =============================================================================

# --- Library ---
# Comma-separated or JSON array of music directories to scan
# TUNE_MUSIC_DIRS=/music,/data/flac
# TUNE_MUSIC_DIRS=["/music", "/data/flac"]

# --- Server ---
TUNE_PORT=8888

# --- Squeezebox / SlimProto (platines Squeezebox, Squeezelite, piCorePlayer) ---
# Tune parle SlimProto lui-même : une platine se connecte directement, sans
# Lyrion (LMS). Deux ports sont pris pour cela, et ils ne sont réglables que par
# ces deux variables.
#
# TUNE_SLIMPROTO_PORT — port 3483 par défaut, TCP (le canal de la platine) ET
# UDP (le répondeur de découverte : c'est là que la platine diffuse sa question).
# ⚠️ Un Lyrion/LMS installé sur la même machine tient déjà ce port. Tant que
#    l'un des deux ne bouge pas, les platines ne voient pas Tune. Le journal du
#    démarrage le dit alors explicitement (« un autre serveur ecoute deja sur le
#    port TCP 3483 »).
# ⚠️ Déplacer ce port déplace AUSSI le répondeur de découverte : une platine qui
#    cherche par diffusion sur 3483 ne trouvera plus Tune. Il faut alors lui
#    donner l'adresse du serveur à la main (« Server address » sur la platine).
# TUNE_SLIMPROTO_PORT=3483

# TUNE_CLI_PORT — port 9090 par défaut. C'est le port de commande texte compatible
# LMS, celui que cherchent les télécommandes tierces (Squeeze-LX, Squeezer…).
# Ce n'est PAS le 9000 de l'interface web de LMS, que Tune n'émule pas.
# TUNE_CLI_PORT=9090

# --- Database ---
# TUNE_DB_PATH=tune.db

# --- Logging ---
# TUNE_LOG_LEVEL=info

# --- Auto-scan on startup ---
# TUNE_AUTO_SCAN=true

# --- Update notice (#3217) ---
# Check every 6 hours whether a newer release exists on the configured update
# channel, and record it so the UI can show it (GET /system/update/status,
# field `available_update`). NOTHING is installed automatically: installing
# restarts the server and cuts playback, so it stays a deliberate action.
# TUNE_AUTO_UPDATE=true

# =============================================================================
# METADATA ENRICHMENT
# =============================================================================

# --- Discogs (FREE) ---
# Artist images and album metadata.
# Get your token at: https://www.discogs.com/settings/developers
# TUNE_DISCOGS_TOKEN=your_discogs_token_here

# --- Last.fm (FREE) ---
# TUNE_LASTFM_API_KEY=
# TUNE_LASTFM_API_SECRET=

# =============================================================================
# STREAMING SERVICES
# =============================================================================

# --- Tidal (OAuth, log in from web UI) ---
# TUNE_TIDAL_ENABLED=false

# --- Qobuz ---
# TUNE_QOBUZ_ENABLED=false

# --- Deezer (requires ARL cookie from deezer.com) ---
# TUNE_DEEZER_ENABLED=false
# TUNE_DEEZER_ARL=

# --- Spotify ---
# TUNE_SPOTIFY_ENABLED=false
# TUNE_SPOTIFY_CLIENT_ID=

# --- YouTube ---
# TUNE_YOUTUBE_ENABLED=false

# =============================================================================
# AUDIO
# =============================================================================

# Output format for DLNA: flac, wav, pcm
# TUNE_DEFAULT_OUTPUT_FORMAT=flac

# Windows audio backend: auto, wasapi, asio
#
# "auto" means WASAPI — it does NOT try ASIO. Probing an ASIO driver can crash
# the process, so ASIO is only ever used when you ask for it by name here.
# Seeing your ASIO drivers listed in the interface does not mean they are in
# use: to actually play through ASIO, set this to "asio".
#
# TUNE_LOCAL_AUDIO_BACKEND is the canonical name. The older TUNE_AUDIO_BACKEND
# is still read as a fallback, so existing .env files keep working — but prefer
# the name below for anything new.
# TUNE_LOCAL_AUDIO_BACKEND=auto

# Exclusive/bit-perfect mode (WASAPI exclusive, CoreAudio hog)
# TUNE_LOCAL_EXCLUSIVE_MODE=false

# =============================================================================
# NETWORK & DISCOVERY
# =============================================================================

# Override advertised IP (useful behind VPN or multi-NIC)
# TUNE_ADVERTISED_IP=192.168.1.100

# =============================================================================
# ACCÉLÉRATIONS DE DÉMARRAGE (toutes OFF par défaut — voir ci-dessous)
# =============================================================================
#
# Cinq raccourcis existent pour réduire le délai avant la première note. Ils
# sont TOUS désactivés par défaut et n'ont jamais été activés en production :
# chacun a été livré en juillet/août 2026 en attendant une validation d'écoute
# sur du matériel réel, validation dont aucune trace n'existe sauf pour
# TUNE_DASH_STREAM_REMUX. Drapeau absent = chemin historique, octet pour octet.
#
# ⚠️ N'en activez qu'UN À LA FOIS, et écoutez une piste entière : plusieurs
# d'entre eux dégradent des garde-fous silencieusement (détails ci-dessous).
#
# Les quatre premiers ne concernent QUE Tidal en DASH multi-segment (le seul
# service qui produise une URL `file://`) vers une zone qui accepte le FLAC et
# SANS égaliseur de zone : un égaliseur ou un renderer WAV les court-circuite
# tous, sans exception.

# Remuxe le FLAC de Tidal au lieu de le décoder puis de le ré-encoder. Sortie
# bit-identique. C'est de loin le plus gros gain (l'étape dominante disparaît).
# ⚠️ Les VU-mètres restent muets sur ces pistes : rien n'est décodé, donc aucun
#    PCM ne remonte. ⚠️ Une piste DASH qui ne serait PAS du FLAC échoue au lieu
#    de retomber sur le décodage.
# TUNE_DASH_REMUX=0

# Garde le transcodage terminé sur disque et le ressert au rejeu, et prépare la
# piste suivante en fond. Même mécanique (préfixe tune-tcache-, plafond
# TUNE_TRANSCODE_CACHE_MAX_MB, éviction LRU) que le cache déjà actif par défaut
# sur les fichiers locaux. Ne change NI le décodage NI les octets servis.
# ⚠️ Le téléchargement DASH, lui, est déjà fait quand le cache est consulté : un
#    succès de cache évite le transcodage, pas le téléchargement.
# TUNE_DASH_WARM_CACHE=0

# Sert le FLAC remuxé en chunked pendant que le téléchargement tourne
# (démarrage quasi instantané). Validé sur Eversolo DMP-A8.
# ⚠️ Chunked = pas de Content-Length : ~50 % des renderers DLNA le refusent, et
#    la protection anti-troncature de fin de piste ne fonctionne plus (une piste
#    coupée par le réseau est prise pour une fin normale). À réserver aux
#    renderers de classe Lavf.
# TUNE_DASH_STREAM_REMUX=0

# Décode le fMP4 pendant qu'il se télécharge au lieu d'attendre la fin.
# TUNE_DASH_STREAM_DECODE=0

# Sans rapport avec Tidal : concerne les fichiers posés sur un montage RÉSEAU
# (NFS/SMB/WebDAV). Décode la copie locale au fur et à mesure au lieu d'attendre
# la copie complète.
# ⚠️ Ce chemin CONTOURNE le cache de staging et son verrou anti-doublon : le
#    même fichier rejoué est recopié depuis le réseau à chaque fois.
# TUNE_STAGE_STREAM_DECODE=0
