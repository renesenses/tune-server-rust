# Tune Bridge relay — lightweight cloud proxy
FROM rust:1-bookworm AS builder

WORKDIR /build

# Tout l'espace de travail, et non plus une liste de manifestes recopiés à la
# main. Cette liste datait de juin (cinq membres) ; l'espace de travail en
# compte vingt aujourd'hui, avec des dépendances par chemin (`vendor/*`,
# `tune-output-api`…). Cargo lit le manifeste de CHAQUE membre avant de
# construire quoi que ce soit : l'ancienne recette échouait sur
# `failed to load manifest for dependency tune-output-api`, et l'image du pont
# en production était restée figée au 29/07. `.dockerignore` écarte `target/`
# et `.git/`. On perd le cache des dépendances entre deux constructions ; le
# pont se reconstruit rarement, une construction propre prend deux minutes.
COPY . .
RUN cargo build --release --locked -p tune-bridge && \
    strip target/release/tune-bridge

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false tune
USER tune

COPY --from=builder /build/target/release/tune-bridge /app/tune-bridge

EXPOSE 9090
ENV BRIDGE_PORT=9090
ENV RUST_LOG=tune_bridge=info

CMD ["/app/tune-bridge"]
